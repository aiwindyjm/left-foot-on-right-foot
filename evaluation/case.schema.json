{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "maxItems": 40,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "group",
      "review",
      "goal",
      "observation",
      "evidence",
      "expected"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "group": {
        "enum": [
          "normal",
          "critical",
          "coordination"
        ]
      },
      "review": {
        "enum": [
          "PLAN",
          "REPORT"
        ]
      },
      "goal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "observation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actions",
          "evidence",
          "rationale"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "DISPATCH_TASK",
                "REQUEST_REVISION",
                "FORWARD_REPORT",
                "HUMAN_GATE",
                "PAUSE",
                "COMPLETED",
                "ERROR"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
