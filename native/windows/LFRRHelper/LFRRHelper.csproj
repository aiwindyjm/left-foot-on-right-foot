<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedTargetFramework>net10.0-windows</SupportedTargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LFRR.Helper</RootNamespace>
    <AssemblyName>lfrr-helper</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- stdin/stdout 属于协议通道，控制台编码需为 UTF-8 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

  <!--
    发布（自包含，无需开发 SDK 的目标机）：
      dotnet publish LFRRHelper.csproj -c Release -r win-x64 --self-contained true
        /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true
    本仓库当前环境无 .NET SDK：编译与真实 UIA 行为 NOT_RUN（批次A）。
  -->

</Project>
