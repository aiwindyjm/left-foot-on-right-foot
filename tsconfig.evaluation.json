{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "tools/evaluation",
    "outDir": ".cache/evaluation",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["tools/evaluation/**/*.ts"]
}
